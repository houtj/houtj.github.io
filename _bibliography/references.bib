journal = "Beijing Hangkong Hangtian Daxue Xuebao/Journal of Beijing University of Aeronautics and Astronautics",
issn = "1001-5965",
publisher = "Beijing University of Aeronautics and Astronautics (BUAA)",
number = "9",
keywords = {reviews},
}


